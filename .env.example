# Copy this file to .env before running the e2e suite:
#
#   cp .env.example .env
#
# The e2e suite reads its login credentials from here rather than having
# them hardcoded in fixtures/test-data/users.ts. The values below match the
# seeded demo accounts documented in this repo's README ("Seeded logins")
# — they're already public there since this app has no backend and no real
# secrets to protect. Override them here if you ever point the suite at a
# different environment with real credentials.

QA_ADMIN_EMAIL=admin@qa.test
QA_ADMIN_PASSWORD=admin123
QA_ACCOUNTANT_EMAIL=accountant@qa.test
QA_ACCOUNTANT_PASSWORD=acct123
